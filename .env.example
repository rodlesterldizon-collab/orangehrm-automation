# Application Base URL (OrangeHRM OS 5.9 Open Source Demo)
BASE_URL="https://opensource-demo.orangehrmlive.com"

# Administrator Credentials (Populate in your local .env.test, which is git-ignored)
ADMIN_USERNAME="your_admin_username_here"
ADMIN_PASSWORD="your_admin_password_here"

# Execution & Artifact Flags
CI=false
PLAYWRIGHT_SCREENSHOT="only-on-failure"   # Options: 'off' | 'only-on-failure' | 'on'
PLAYWRIGHT_VIDEO="off"                   # Options: 'off' | 'retain-on-failure' | 'on'
PLAYWRIGHT_TRACE="retain-on-failure"     # Options: 'off' | 'on-first-retry' | 'retain-on-failure' | 'on'
