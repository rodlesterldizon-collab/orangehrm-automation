{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Playwright: Debug Current Test File",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
      "args": ["test", "${file}", "--headed", "--debug"],
      "console": "integratedTerminal"
    },
    {
      "name": "AI Tool: Debug Test Healer",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/tools/test-healer.ts",
      "runtimeArgs": ["--experimental-strip-types"],
      "console": "integratedTerminal"
    }
  ]
}
